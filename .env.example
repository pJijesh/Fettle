# Used to sign patient links (booking changes, forms, waiting-list offers). At least 16 random characters.
# Changing it invalidates every link already sent. Generate one with: openssl rand -base64 32
LINK_SECRET=generate-a-long-random-string

# Where the SQLite file lives in development.
DATABASE_PATH=./data/app.db

# Public base URL used when building links in emails and texts. Use https in production.
APP_BASE_URL=http://localhost:3000

# Optional: lets an external scheduler call POST /api/worker with "Authorization: Bearer <this>".
# The app also runs its own background tick every 30 seconds; set DISABLE_BACKGROUND_TICK=1 to turn that off.
CRON_SECRET=
DISABLE_BACKGROUND_TICK=

# AI drafting. Leave ANTHROPIC_API_KEY empty to use the offline mock provider (not clinical).
AI_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cliniko write-back (optional). Leave empty to use copy-ready output only.
CLINIKO_API_KEY=
CLINIKO_USER_AGENT=ConsultToProgramme (you@example.com)
CLINIKO_TEMPLATE_ID=
